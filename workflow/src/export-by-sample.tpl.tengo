// Cross-group export stage.
//
// Consumes the three per-group outputs that demux-group emits:
//   - nestedMics:             ResourceMap[groupId] -> std/map { <bc>.result.mic -> File }
//   - barcodeToSampleByGroup: ResourceMap[groupId] -> std/json { <bc>: <sampleId> }
//   - isPairedByGroup:        ResourceMap[groupId] -> std/json bool
//
// Regroups the mics by sampleId across all groups and runs a SINGLE
// `mitool export-fastq` per sampleId, passing every .mic file belonging to
// that sample (from every group it appears in) as an input. mitool 2.3.1-55+
// `export-fastq` accepts N .mic inputs and concatenates their reads in order —
// see .meta/mitool-demux-block-changes-shipped.md. This replaces the old
// per-group export path + flatten-with-collision-panic: cross-group same-
// sampleId merging is the expected, natural case now.
//
// Output: a single flat ResourceMap[sampleId, readIndex] -> File, which
// demux-process passes straight through as the `demultiplexedFastq` PColumn
// data — no further flatten stage needed.

self := import("@platforma-sdk/workflow-tengo:tpl")
ll := import("@platforma-sdk/workflow-tengo:ll")
smart := import("@platforma-sdk/workflow-tengo:smart")
exec := import("@platforma-sdk/workflow-tengo:exec")
assets := import("@platforma-sdk/workflow-tengo:assets")
pcolumn := import("@platforma-sdk/workflow-tengo:pframes.pcolumn")
maps := import("@platforma-sdk/workflow-tengo:maps")
slices := import("@platforma-sdk/workflow-tengo:slices")
text := import("text")

self.defineOutputs("demultiplexedFastqData")

// Each outer is a PColumnData/ResourceMap[groupId] (from processColumn's
// `type: "Resource"` wrapping). Wildcard await on every per-group inner is
// required — the outer ResourceReady just means the outer map's input list
// is locked, not that the per-group resources inside are ready.
self.awaitState("nestedMics", "ResourceReady")
self.awaitState("nestedMics", { wildcard: "*" }, "ResourceReady")
self.awaitState("barcodeToSampleByGroup", "ResourceReady")
self.awaitState("barcodeToSampleByGroup", { wildcard: "*" }, "ResourceReady")
self.awaitState("isPairedByGroup", "ResourceReady")
self.awaitState("isPairedByGroup", { wildcard: "*" }, "ResourceReady")

mitoolSw := assets.importSoftware("@platforma-open/milaboratories.software-mitool:main")

MIC_SUFFIX := ".result.mic"

self.body(func(inputs) {
	// PColumnData/ResourceMap does NOT match smart.isMapResource (only std/map
	// does). _unmarshal returns the raw resource for us, so we iterate via
	// .inputs() — the same pattern flatten.tpl.tengo used.
	nestedMics := inputs.nestedMics
	barcodeToSampleByGroup := inputs.barcodeToSampleByGroup
	isPairedByGroup := inputs.isPairedByGroup

	ll.assert(smart.isResource(nestedMics), "nestedMics must be a resource")
	ll.assert(smart.isResource(barcodeToSampleByGroup), "barcodeToSampleByGroup must be a resource")
	ll.assert(smart.isResource(isPairedByGroup), "isPairedByGroup must be a resource")

	// Build per-group barcode→sampleId lookup. Inner is std/json — read via getDataAsJson.
	b2sByGroupKey := {}
	b2sInputs := barcodeToSampleByGroup.inputs()
	for groupKey in maps.getKeys(b2sInputs) {
		fieldRef := b2sInputs[groupKey]
		if fieldRef.isErrorSet() {
			ll.panic("group %s barcodeToSample has error", groupKey)
		}
		b2sByGroupKey[groupKey] = fieldRef.getValue().getDataAsJson()
	}

	// isPaired is uniform across groups by construction (input dataset has one
	// readIndex axis), but assert to be safe. Empty map (no groups) → false.
	isPaired := undefined
	ipInputs := isPairedByGroup.inputs()
	for groupKey in maps.getKeys(ipInputs) {
		fieldRef := ipInputs[groupKey]
		if fieldRef.isErrorSet() {
			ll.panic("group %s isPaired has error", groupKey)
		}
		val := fieldRef.getValue().getDataAsJson()
		if is_undefined(isPaired) {
			isPaired = val
		} else {
			ll.assert(isPaired == val,
				"sample groups disagree on isPaired — all groups must share the same paired-end status")
		}
	}
	if is_undefined(isPaired) {
		isPaired = false
	}

	// Regroup mics by sampleId. Each entry carries groupKey + fileName + field
	// reference (accepted directly by exec.builder().addFile()).
	sampleToMics := {}
	micsInputs := nestedMics.inputs()
	for groupKey in maps.getKeys(micsInputs) {
		fieldRef := micsInputs[groupKey]
		if fieldRef.isErrorSet() {
			ll.panic("group %s mics has error", groupKey)
		}
		groupMics := fieldRef.getValue()
		if !smart.isResource(groupMics) {
			continue
		}
		// Empty-group sentinel (createNullResource) — nothing to export.
		if !smart.isMapResource(groupMics) {
			continue
		}
		b2s := b2sByGroupKey[groupKey]
		if is_undefined(b2s) {
			continue
		}
		fileFields := groupMics.inputs()
		for fileName in maps.getKeys(fileFields) {
			if !text.has_suffix(fileName, MIC_SUFFIX) {
				continue
			}
			bc := text.substr(fileName, 0, len(fileName) - len(MIC_SUFFIX))
			sampleId := b2s[bc]
			if is_undefined(sampleId) {
				// Mitool captured a barcode outside the expected set — possible
				// with a wildcard SMPL1 capture. Safe to drop.
				continue
			}
			if is_undefined(sampleToMics[sampleId]) {
				sampleToMics[sampleId] = []
			}
			sampleToMics[sampleId] = append(sampleToMics[sampleId], {
				groupKey: groupKey,
				fileName: fileName,
				micFile: fileFields[fileName]
			})
		}
	}

	progressPrefix := "[==MITOOL_PROGRESS==]"
	fastqBuilder := pcolumn.resourceMapBuilder(2)

	// One export-fastq per sample, consuming every .mic that carries its reads.
	for sampleId in maps.getKeys(sampleToMics) {
		micEntries := sampleToMics[sampleId]
		// Deterministic input order — groupKey first, then fileName.
		micEntries = slices.quickSortFn(micEntries, func(a, b) {
			if a.groupKey != b.groupKey {
				return a.groupKey < b.groupKey
			}
			return a.fileName < b.fileName
		})

		exportCmd := exec.builder().
			printErrStreamToStdout().
			env("MI_PROGRESS_PREFIX", progressPrefix).
			software(mitoolSw).
			cpu(4).
			mem("16GiB").
			arg("export-fastq").
			arg("--output-file").arg("R1.fastq.gz").arg("R1").saveFile("R1.fastq.gz")

		if isPaired {
			exportCmd = exportCmd.arg("--output-file").arg("R2.fastq.gz").arg("R2").saveFile("R2.fastq.gz")
		}

		// Unique workdir-local names per input: the same barcode may appear in
		// multiple groups, so reusing the raw fileName would clobber files.
		execArgs := []
		for i, entry in micEntries {
			localName := "g" + string(i) + "-" + entry.fileName
			exportCmd = exportCmd.addFile(localName, entry.micFile)
			execArgs = append(execArgs, localName)
		}
		for a in execArgs {
			exportCmd = exportCmd.arg(a)
		}

		exportResult := exportCmd.run()

		fastqBuilder.add([sampleId, "R1"], exportResult.getFile("R1.fastq.gz"))
		if isPaired {
			fastqBuilder.add([sampleId, "R2"], exportResult.getFile("R2.fastq.gz"))
		}
	}

	return {
		demultiplexedFastqData: fastqBuilder.build()
	}
})
