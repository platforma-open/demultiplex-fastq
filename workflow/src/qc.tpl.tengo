// Per-sample QC aggregation.
//
// Consumes two per-group outputs from demux-group:
//   - reportJsonByGroup:    ResourceMap[groupId] -> Value (file content of
//                           `report.json`, saved via saveFileContent)
//   - tupleToSampleByGroup: ResourceMap[groupId] -> std/json { <tupleKey>: <sampleId> }
//
// For each group, decodes `parseReport.perSampleMatched` from the JSON report,
// joins each entry's `sampleKey` array with `_` to get the tuple key, looks up
// the matching sampleId via that group's tupleToSample, and accumulates into
// a single flat map `[groupId, sampleId] -> matched`.
//
// Emits PColumnData/Json with keyLength 2 — axes are [sampleGroupId, sampleId]
// per qcSpec in demux-process.

self := import("@platforma-sdk/workflow-tengo:tpl")
ll := import("@platforma-sdk/workflow-tengo:ll")
smart := import("@platforma-sdk/workflow-tengo:smart")
maps := import("@platforma-sdk/workflow-tengo:maps")
pConstants := import("@platforma-sdk/workflow-tengo:pframes.constants")
json := import("json")
text := import("text")

self.defineOutputs("qcData", "qcGroupSummary")

self.awaitState("reportJsonByGroup", "ResourceReady")
self.awaitState("reportJsonByGroup", { wildcard: "*" }, "ResourceReady")
self.awaitState("tupleToSampleByGroup", "ResourceReady")
self.awaitState("tupleToSampleByGroup", { wildcard: "*" }, "ResourceReady")

self.body(func(inputs) {
	reportJsonByGroup := inputs.reportJsonByGroup
	tupleToSampleByGroup := inputs.tupleToSampleByGroup

	ll.assert(smart.isResource(reportJsonByGroup), "reportJsonByGroup must be a resource")
	ll.assert(smart.isResource(tupleToSampleByGroup), "tupleToSampleByGroup must be a resource")

	t2sByGroupKey := {}
	t2sInputs := tupleToSampleByGroup.inputs()
	for groupKey in maps.getKeys(t2sInputs) {
		fieldRef := t2sInputs[groupKey]
		if fieldRef.isErrorSet() {
			ll.panic("group %s tupleToSample has error", groupKey)
		}
		t2sByGroupKey[groupKey] = fieldRef.getValue().getDataAsJson()
	}

	// flat         → per-sample matched (drives the QC Report table).
	// groupSummary → per-group {total, matched} (drives the main-table bar col).
	//
	// ResourceMap input field names are JSON-encoded axis-value arrays —
	// e.g. `["g1"]` — decode each to bare sampleGroupId before using as key.
	flat := {}
	groupSummary := {}
	reportInputs := reportJsonByGroup.inputs()
	for groupKey in maps.getKeys(reportInputs) {
		fieldRef := reportInputs[groupKey]
		if fieldRef.isErrorSet() {
			ll.panic("group %s reportJsonContent has error", groupKey)
		}
		decodedGroupKey := json.decode(groupKey)
		ll.assert(is_array(decodedGroupKey) && len(decodedGroupKey) == 1,
			"expected single-axis group key, got %v", groupKey)
		sampleGroupId := string(decodedGroupKey[0])
		contentRes := fieldRef.getValue()
		if !smart.isResource(contentRes) {
			continue
		}
		if smart.isNullResource(contentRes) {
			continue
		}

		report := contentRes.getDataAsJson()
		ll.assert(is_map(report), "group %s report.json did not decode to a map", groupKey)
		parseReport := report.parseReport
		ll.assert(is_map(parseReport), "group %s report.json missing parseReport object", groupKey)

		ll.assert(is_int(parseReport.total),
			"group %s report.json parseReport.total is not an int: %v", sampleGroupId, parseReport.total)
		ll.assert(is_int(parseReport.matched),
			"group %s report.json parseReport.matched is not an int: %v", sampleGroupId, parseReport.matched)
		groupSummary[sampleGroupId] = {
			total: parseReport.total,
			matched: parseReport.matched
		}

		perSample := parseReport.perSampleMatched
		if is_undefined(perSample) {
			// No Sample-type tags in pattern — group summary above is still valid.
			continue
		}
		ll.assert(is_array(perSample), "group %s perSampleMatched is not an array", groupKey)

		t2s := t2sByGroupKey[groupKey]
		if is_undefined(t2s) {
			continue
		}

		for entry in perSample {
			ll.assert(is_map(entry) && is_array(entry.sampleKey),
				"group %s perSampleMatched entry malformed: %v", groupKey, entry)
			ll.assert(len(entry.sampleKey) >= 1,
				"group %s perSampleMatched entry has empty sampleKey", groupKey)
			tupleParts := []
			for v in entry.sampleKey {
				tupleParts = append(tupleParts, string(v))
			}
			tupleKey := text.join(tupleParts, "_")
			sampleId := t2s[tupleKey]
			if is_undefined(sampleId) {
				// Captured tuple not in our expected set (e.g. wildcard capture).
				// Drop silently — matches export-by-sample's behaviour.
				continue
			}
			flat[json.encode([sampleGroupId, sampleId])] = entry.matched
		}
	}

	payload := {
		keyLength: 2,
		data: flat
	}
	return {
		qcData: smart.createValueResource(pConstants.RTYPE_P_COLUMN_DATA_JSON, json.encode(payload)),
		qcGroupSummary: smart.createJsonResource(groupSummary)
	}
})
