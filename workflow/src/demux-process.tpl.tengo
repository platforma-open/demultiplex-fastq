// Ephemeral orchestration template. Decodes the multiplexing rules column,
// rewrites everything user-facing into mitool's canonical S<i> form, then
// dispatches per-group `mitool parse` and per-sample `mitool export-fastq`.
//
// User tag names never reach mitool — the rewrite is total. mitool's TagType
// classifier marks tag names that start with `S` as Sample tags, which enables
// multi-tag auto-split where output mics are named `<v_S1>_<v_S2>...result.mic`.
// We pre-rewrite the pattern and project per-row barcodes into S-index order
// here, so demux-group only ever sees canonical data.

self := import("@platforma-sdk/workflow-tengo:tpl")
render := import("@platforma-sdk/workflow-tengo:render")
assets := import("@platforma-sdk/workflow-tengo:assets")
pframes := import("@platforma-sdk/workflow-tengo:pframes")
pConstants := import("@platforma-sdk/workflow-tengo:pframes.constants")
pSpec := import("@platforma-sdk/workflow-tengo:pframes.spec")
ll := import("@platforma-sdk/workflow-tengo:ll")
json := import("json")
text := import("text")

demuxGroupTpl := assets.importTemplate(":demux-group")
exportBySampleTpl := assets.importTemplate(":export-by-sample")
flattenWithGroupTpl := assets.importTemplate(":flatten-with-group")
qcTpl := assets.importTemplate(":qc")

self.defineOutputs(
	"demultiplexedFastqSpec", "demultiplexedFastqData",
	"mitoolLogsSpec", "mitoolLogsData",
	"reportsSpec", "reportsData",
	"qcSpec", "qcData",
	"qcGroupSummary"
)

self.awaitState("bundle", "PColumnBundleWithPartitions")
self.awaitState("params", "ResourceReady")

// Decodes a PColumnData/Json resource to a Tengo map. Accepts either
// `{ data: {...}, keyLength: N }` or a bare top-level map.
readJsonPColumn := func(name, resource) {
	ll.assert(!is_undefined(resource), "%s resource is undefined", name)
	ll.assert(resource.checkResourceType(pConstants.RTYPE_P_COLUMN_DATA_JSON),
		"%s must be PColumnData/Json, got a different resource type", name)
	decoded := resource.getDataAsJson()
	ll.assert(is_map(decoded), "%s JSON payload is not a map", name)
	if !is_undefined(decoded.data) && is_map(decoded.data) {
		return decoded.data
	}
	return decoded
}

self.body(func(inputs) {
	bundle := inputs.bundle
	params := inputs.params
	blockId := params.blockId
	tagPattern := params.tagPattern
	usedTags := params.usedTags
	limitInput := params.limitInput

	ll.assert(is_array(usedTags) && len(usedTags) > 0, "usedTags must be a non-empty array")

	// Anchor IS the multiplexing rules column.
	rules := bundle.getColumn("main")

	fastqCols := bundle.getColumns("fastq")
	if is_undefined(fastqCols) || len(fastqCols) == 0 {
		ll.panic("No FASTQ data column found for this multiplexing rules column. The Samples & Data block that publishes the rules must also publish the FASTQ data — Run is disabled until both appear.")
	}
	if len(fastqCols) > 1 {
		names := []
		for c in fastqCols {
			names = append(names, c.spec.name)
		}
		ll.panic("Multiple FASTQ data columns matched the multiplexing rules column: %v", names)
	}
	fastq := fastqCols[0]

	sampleGroupIdAxisSpec := rules.spec.axesSpec[0]
	sampleIdAxisSpec := rules.spec.axesSpec[1]
	readIndexAxisSpec := fastq.spec.axesSpec[1]

	// Defence-in-depth — args lambda already gates on these via the snapshot
	// in `data`, but the workflow is the authoritative gate. If S&D re-emitted
	// the column with a different tag set after the user picked it, this is
	// where the mismatch surfaces.
	rulesAnnotations := rules.spec.annotations
	ll.assert(!is_undefined(rulesAnnotations), "multiplexing rules column has no annotations")
	declaredTagsRaw := rulesAnnotations["pl7.app/sequencing/barcodeTags"]
	ll.assert(!is_undefined(declaredTagsRaw),
		"multiplexing rules column is missing the pl7.app/sequencing/barcodeTags annotation")
	declaredTags := json.decode(declaredTagsRaw)
	ll.assert(is_array(declaredTags), "barcodeTags annotation must be a JSON array of strings")
	declaredSet := {}
	for t in declaredTags {
		declaredSet[string(t)] = true
	}
	for t in usedTags {
		ll.assert(!is_undefined(declaredSet[string(t)]),
			"tag %s referenced in tagPattern is not declared on the multiplexing rules column (declared: %v)",
			t, declaredTags)
	}
	nucleotidesOnly := rulesAnnotations["pl7.app/sequencing/barcodeNucleotidesOnly"]
	ll.assert(nucleotidesOnly == "true",
		"multiplexing rules column has barcodeNucleotidesOnly=%v — FASTQ Demultiplexing requires nucleotide barcodes",
		nucleotidesOnly)

	// usedTags is lex-sorted by the model — its position in the sorted list
	// defines the S-tag index. Both the pattern and the per-row barcode tuples
	// are projected into S-index order before reaching demux-group.
	canonicalNames := []
	canonicalPattern := tagPattern
	for i, t in usedTags {
		canonical := "S" + string(i + 1)
		canonicalNames = append(canonicalNames, canonical)
		canonicalPattern = text.replace(canonicalPattern, "{" + string(t) + "}", "{" + canonical + "}", -1)
	}

	// Decode rules: { json([groupId, sampleId]) -> JSON-encoded Array<Record<TagName, Barcode>> }.
	// Project to usedTags only, drop incomplete alternatives, accumulate per group.
	rulesMap := readJsonPColumn("multiplexing rules", rules.data)
	ll.assert(len(rulesMap) > 0, "multiplexing rules column has no entries — nothing to demultiplex")

	// perGroupRows[groupId] = [
	//   { sampleId: <id>, values: [v_S1, v_S2, ...], tupleKey: "v_S1_v_S2_..." },
	//   ...
	// ]
	perGroupRows := {}
	// Per-group lookup `tupleKey -> sampleId` for conflict detection (same
	// barcode tuple, different sampleId within one group).
	perGroupTupleSeen := {}

	for encodedKey, valueStr in rulesMap {
		keyArr := json.decode(encodedKey)
		ll.assert(is_array(keyArr) && len(keyArr) == 2,
			"invalid rules key (expected 2-tuple [groupId, sampleId]): %v", encodedKey)
		groupId := string(keyArr[0])
		sampleId := string(keyArr[1])

		alternatives := json.decode(string(valueStr))
		ll.assert(is_array(alternatives),
			"rules cell [%s,%s] value is not a JSON array: %v", groupId, sampleId, valueStr)

		for alt in alternatives {
			ll.assert(is_map(alt),
				"rules cell [%s,%s] alternative is not a record: %v", groupId, sampleId, alt)

			// Project to usedTags. Drop alternative if any usedTag is missing or empty.
			values := []
			incomplete := false
			for t in usedTags {
				v := alt[string(t)]
				if is_undefined(v) {
					incomplete = true
					break
				}
				vs := string(v)
				if vs == "" {
					incomplete = true
					break
				}
				values = append(values, vs)
			}
			if incomplete {
				continue
			}

			// Underscore-joined tuple — matches mitool's MultiSampleRun output
			// filename `<v_S1>_<v_S2>...result.mic`.
			tupleKey := text.join(values, "_")

			seenForGroup := perGroupTupleSeen[groupId]
			if is_undefined(seenForGroup) {
				seenForGroup = {}
			}
			existingSampleId := seenForGroup[tupleKey]
			if !is_undefined(existingSampleId) && existingSampleId != sampleId {
				ll.panic(
					"barcode-tuple conflict in sampleGroup %s: tuple %v maps to both sample %s and sample %s",
					groupId, values, existingSampleId, sampleId)
			}
			seenForGroup[tupleKey] = sampleId
			perGroupTupleSeen[groupId] = seenForGroup

			rows := perGroupRows[groupId]
			if is_undefined(rows) {
				rows = []
			}
			rows = append(rows, {
				sampleId: sampleId,
				values: values,
				tupleKey: tupleKey
			})
			perGroupRows[groupId] = rows
		}
	}
	ll.assert(len(perGroupRows) > 0,
		"every multiplexing rule cell was empty or missing usedTags — nothing to demultiplex")

	// Provenance trace for user-facing outputs. Anchored on the FASTQ input
	// spec so the lineage chain reads "multiplexed FASTQ -> demultiplex".
	blockTrace := pSpec.makeTrace(fastq.spec, {
		type: "milaboratories.demux",
		id: blockId,
		importance: 10,
		label: "FASTQ Demultiplexing"
	})

	demuxedFastqSpec := blockTrace.inject({
		kind: "PColumn",
		name: "pl7.app/sequencing/data",
		domain: {
			"pl7.app/fileExtension": "fastq.gz",
			"pl7.app/block": blockId,
			"pl7.app/dataset": "demultiplexed"
		},
		valueType: "File",
		annotations: {
			"pl7.app/label": "Demultiplexed FASTQ"
		},
		axesSpec: [sampleIdAxisSpec, readIndexAxisSpec]
	})

	mitoolLogSpec := {
		kind: "PColumn",
		name: "milaboratories.demux/log",
		domain: {
			"pl7.app/block": blockId
		},
		valueType: "Log",
		annotations: {
			"pl7.app/label": "mitool parse log"
		},
		axesSpec: [sampleGroupIdAxisSpec]
	}

	reportFormatAxisSpec := {
		type: "String",
		name: "milaboratories.demux/reportFormat",
		annotations: {
			"pl7.app/label": "Report format"
		}
	}
	reportsSpec := {
		kind: "PColumn",
		name: "milaboratories.demux/report",
		domain: {
			"pl7.app/block": blockId
		},
		valueType: "File",
		annotations: {
			"pl7.app/label": "Parse report"
		},
		axesSpec: [sampleGroupIdAxisSpec, reportFormatAxisSpec]
	}

	micsSpec := {
		kind: "PColumn",
		name: "milaboratories.demux/mics",
		domain: { "pl7.app/block": blockId },
		valueType: "File",
		axesSpec: [sampleGroupIdAxisSpec]
	}
	tupleToSampleSpec := {
		kind: "PColumn",
		name: "milaboratories.demux/tupleToSample",
		domain: { "pl7.app/block": blockId },
		valueType: "String",
		axesSpec: [sampleGroupIdAxisSpec]
	}
	isPairedSpec := {
		kind: "PColumn",
		name: "milaboratories.demux/isPaired",
		domain: { "pl7.app/block": blockId },
		valueType: "String",
		axesSpec: [sampleGroupIdAxisSpec]
	}
	reportJsonContentSpec := {
		kind: "PColumn",
		name: "milaboratories.demux/reportJsonContent",
		domain: { "pl7.app/block": blockId },
		valueType: "String",
		axesSpec: [sampleGroupIdAxisSpec]
	}

	qcSpec := blockTrace.inject({
		kind: "PColumn",
		name: "milaboratories.demux/matchedReads",
		domain: {
			"pl7.app/block": blockId
		},
		valueType: "Long",
		annotations: {
			"pl7.app/label": "Matched reads"
		},
		axesSpec: [sampleGroupIdAxisSpec, sampleIdAxisSpec]
	})

	demuxOutputs := [{
		type: "Resource",
		spec: mitoolLogSpec,
		name: "mitoolLog"
	}, {
		type: "Resource",
		spec: reportsSpec,
		name: "reports"
	}, {
		type: "Resource",
		spec: micsSpec,
		name: "mics"
	}, {
		type: "Resource",
		spec: tupleToSampleSpec,
		name: "tupleToSample"
	}, {
		type: "Resource",
		spec: isPairedSpec,
		name: "isPaired"
	}, {
		type: "Resource",
		spec: reportJsonContentSpec,
		name: "reportJsonContent"
	}]

	perGroupResult := pframes.processColumn(
		{ spec: fastq.spec, data: fastq.data },
		demuxGroupTpl,
		demuxOutputs,
		{
			aggregate: [
				{ name: "pl7.app/sequencing/readIndex", optional: true }
			],
			passAggregationAxesNames: true,
			passKey: true,
			traceSteps: [{
				type: "milaboratories.demux",
				id: blockId,
				importance: 10,
				label: "FASTQ Demultiplexing"
			}],
			extra: {
				perGroupRows: perGroupRows,
				canonicalNames: canonicalNames,
				canonicalPattern: canonicalPattern,
				limitInput: limitInput
			}
		}
	)

	exportResult := render.createEphemeral(exportBySampleTpl, {
		nestedMics: perGroupResult.outputData("mics"),
		tupleToSampleByGroup: perGroupResult.outputData("tupleToSample"),
		isPairedByGroup: perGroupResult.outputData("isPaired")
	})

	reportsFlat := render.createEphemeral(flattenWithGroupTpl, {
		nestedMap: perGroupResult.outputData("reports"),
		flatKeyLength: 2
	})

	qcResult := render.createEphemeral(qcTpl, {
		reportJsonByGroup: perGroupResult.outputData("reportJsonContent"),
		tupleToSampleByGroup: perGroupResult.outputData("tupleToSample")
	})

	return {
		demultiplexedFastqSpec: demuxedFastqSpec,
		demultiplexedFastqData: exportResult.output("demultiplexedFastqData"),
		mitoolLogsSpec: mitoolLogSpec,
		mitoolLogsData: perGroupResult.outputData("mitoolLog"),
		reportsSpec: reportsSpec,
		reportsData: reportsFlat.output("flat"),
		qcSpec: qcSpec,
		qcData: qcResult.output("qcData"),
		qcGroupSummary: qcResult.output("qcGroupSummary")
	}
})
