// Expands one barcode row into a mitool read pattern.
// `{S<i>}` becomes `(S<i>:<value>)`. A tag that is already captured on R1 becomes the
// bare value on R2: mitool rejects a capture name repeated across mates, and the bare
// value makes the pair match only when both mates carry the barcode.

text := import("text")

substitute := func(side, names, values, literalNames) {
	out := side
	for i, name in names {
		placeholder := "{" + name + "}"
		replacement := "(" + name + ":" + values[i] + ")"
		if literalNames[name] {
			replacement = values[i]
		}
		out = text.replace(out, placeholder, replacement, -1)
	}
	return out
}

expandSingle := func(r1Side, names, values) {
	return substitute(r1Side, names, values, {})
}

expandPair := func(r1Side, r2Side, names, values) {
	onR1 := {}
	for name in names {
		if text.contains(r1Side, "{" + name + "}") {
			onR1[name] = true
		}
	}
	return substitute(r1Side, names, values, {}) + "\\" + substitute(r2Side, names, values, onR1)
}

export {
	expandSingle: expandSingle,
	expandPair: expandPair
}
