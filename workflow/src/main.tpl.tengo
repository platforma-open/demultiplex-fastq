wf := import("@platforma-sdk/workflow-tengo:workflow")
render := import("@platforma-sdk/workflow-tengo:render")
ll := import("@platforma-sdk/workflow-tengo:ll")
assets := import("@platforma-sdk/workflow-tengo:assets")
pframes := import("@platforma-sdk/workflow-tengo:pframes")
smart := import("@platforma-sdk/workflow-tengo:smart")

demuxProcessTpl := assets.importTemplate(":demux-process")

wf.body(func(args) {
	ll.assert(!is_undefined(args.inputRef), "multiplexing rules column is required")
	ll.assert(!is_undefined(args.tagPattern) && args.tagPattern != "", "tag pattern is required")
	ll.assert(!is_undefined(args.usedTags) && len(args.usedTags) > 0, "usedTags is required")

	blockId := wf.blockId().getDataAsJson()

	// Single anchor: the multiplexing rules column. The matching FASTQ dataset
	// is resolved as a query with the same block + dataset domain on the
	// sampleGroupId axis. The rules column carries per-cell barcodes inline —
	// no separate barcode-source ref.
	bundleBuilder := wf.createPBundleBuilder()
	bundleBuilder.addAnchor("main", args.inputRef)
	bundleBuilder.addMulti({
		axes: [
			{ anchor: "main", idx: 0 },
			{ name: "pl7.app/sequencing/readIndex", type: "String" }
		],
		name: "pl7.app/sequencing/data",
		domain: {
			"pl7.app/block": { anchor: "main" },
			"pl7.app/dataset": { anchor: "main" }
		}
	}, "fastq")
	bundle := bundleBuilder.build()

	demuxResult := render.createEphemeral(demuxProcessTpl, {
		bundle: bundle,
		params: smart.createJsonResource({
			blockId: blockId,
			tagPattern: args.tagPattern,
			usedTags: args.usedTags,
			limitInput: args.limitInput,
			perProcessMemGB: args.perProcessMemGB,
			perProcessCPUs: args.perProcessCPUs
		})
	})

	demultiplexedFastqSpec := demuxResult.output("demultiplexedFastqSpec")
	demultiplexedFastqData := demuxResult.output("demultiplexedFastqData")
	mitoolLogsData := demuxResult.output("mitoolLogsData")
	reportsSpec := demuxResult.output("reportsSpec")
	reportsData := demuxResult.output("reportsData")
	qcSpec := demuxResult.output("qcSpec")
	qcData := demuxResult.output("qcData")
	qcGroupSummary := demuxResult.output("qcGroupSummary")

	return {
		outputs: {
			demultiplexedFastq: pframes.exportColumnData(demultiplexedFastqData),
			mitoolLogs: mitoolLogsData,
			reports: pframes.exportColumnData(reportsData),
			qc: qcData,
			qcGroupSummary: qcGroupSummary
		},
		exports: {
			demultiplexedFastq: {
				spec: demultiplexedFastqSpec,
				data: demultiplexedFastqData
			},
			reports: {
				spec: reportsSpec,
				data: reportsData
			},
			qc: {
				spec: qcSpec,
				data: qcData
			}
		}
	}
})
