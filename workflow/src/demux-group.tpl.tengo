// Per-group demultiplexing template.
// Invoked by pframes.processColumn in demux-process.tpl.tengo, once per
// sampleGroupId. All inputs arrive in mitool's canonical form — this template
// never sees user tag names.
//
// Inputs from `extra`:
//   perGroupRows[groupId]: [{ sampleId, values: [v_S1, v_S2, ...], tupleKey }]
//   canonicalNames:        ["S1", "S2", ...]   — S-index order
//   canonicalPattern:      tagPattern with `{S<i>}` placeholders
//   limitInput:            optional Int for --limit (preview mode)
//
// Outputs (aggregated across groups by processColumn):
//   - mics:              fileSet `{<tupleKey>.result.mic -> File}`
//   - tupleToSample:     JSON `{<tupleKey>: <sampleId>}` for this group
//   - isPaired:          JSON bool — paired-end status of the input
//   - mitoolLog:         merged stderr/stdout stream
//   - reports:           ResourceMap[reportFormat] -> File for txt+json
//   - reportJsonContent: JSON content of report.json — feeds qc.tpl.tengo
//
// No //tengo:hash_override here — content-hashing handles cache invalidation
// naturally; hash_override + stepCache previously caused stale-cache traps.

self := import("@platforma-sdk/workflow-tengo:tpl.light")
ll := import("@platforma-sdk/workflow-tengo:ll")
smart := import("@platforma-sdk/workflow-tengo:smart")
exec := import("@platforma-sdk/workflow-tengo:exec")
assets := import("@platforma-sdk/workflow-tengo:assets")
pConstants := import("@platforma-sdk/workflow-tengo:pframes.constants")
pcolumn := import("@platforma-sdk/workflow-tengo:pframes.pcolumn")
slices := import("@platforma-sdk/workflow-tengo:slices")
json := import("json")
text := import("text")

self.defineOutputs("mics", "tupleToSample", "isPaired", "mitoolLog", "reports", "reportJsonContent")

mitoolSw := assets.importSoftware("@platforma-open/milaboratories.software-mitool:main")

self.body(func(inputs) {
	perGroupRows := inputs.perGroupRows
	canonicalNames := inputs.canonicalNames
	canonicalPattern := inputs.canonicalPattern
	limitInput := inputs.limitInput

	currentKey := inputs[pConstants.KEY_FIELD_NAME]
	ll.assert(is_array(currentKey) && len(currentKey) > 0, "expected key to contain groupId")
	currentGroupId := string(currentKey[0])

	rows := perGroupRows[currentGroupId]
	if is_undefined(rows) || len(rows) == 0 {
		// Empty group — no parse run. Downstream iteration skips null inners.
		return {
			mics: smart.createNullResource(),
			tupleToSample: {},
			isPaired: false,
			mitoolLog: smart.createNullResource(),
			reports: pcolumn.resourceMapBuilder(1).build(),
			reportJsonContent: smart.createNullResource()
		}
	}

	// Deterministic branch order for cache-key stability — sort rows by tupleKey.
	rows = slices.quickSortFn(rows, func(a, b) {
		return a.tupleKey < b.tupleKey
	})

	tupleToSample := {}
	for r in rows {
		tupleToSample[r.tupleKey] = r.sampleId
	}

	currentElement := inputs[pConstants.VALUE_FIELD_NAME]
	ll.assert(!is_undefined(currentElement) && smart.isResource(currentElement), "invalid input element")

	R1File := undefined
	R2File := undefined
	for sKey, inFile in currentElement.inputs() {
		key := json.decode(sKey)
		r := key[0]
		if r == "R1" { R1File = inFile }
		if r == "R2" { R2File = inFile }
	}
	ll.assert(!is_undefined(R1File), "no R1 input file found")
	isPaired := !is_undefined(R2File)

	// Pattern construction.
	// mitool grammar: `\` separates R1 and R2 sides and binds tighter than `|`,
	// so `A | B\C` means "(A | B) on R1, C on R2". Substitute `{S<i>}`
	// placeholders only on the R1 side, join branches with ` | `, re-attach R2.
	// canonicalPattern is whitespace-stripped already (model side).
	backslash := "\\"
	parts := text.split(canonicalPattern, backslash)
	// Guard: pattern declares two reads (has a `\`) but input is single-end.
	ll.assert(!(len(parts) > 1 && !isPaired),
		"tag pattern declares an R2 side (contains '\\\\') but input FASTQ is single-end")
	r1UserPart := parts[0]
	r2UserPart := ""
	if len(parts) > 1 {
		r2UserPart = text.join(parts[1:], backslash)
	}
	if r2UserPart == "" && isPaired {
		r2UserPart = "^(R2:*)"
	}

	variants := []
	for r in rows {
		branch := r1UserPart
		for i, name in canonicalNames {
			capture := "(" + name + ":" + r.values[i] + ")"
			branch = text.replace(branch, "{" + name + "}", capture, -1)
		}
		variants = append(variants, branch)
	}
	expandedPattern := text.join(variants, " | ")
	if r2UserPart != "" {
		expandedPattern = expandedPattern + backslash + r2UserPart
	}

	progressPrefix := "[==MITOOL_PROGRESS==]"

	// mitool parse auto-splits output into <tupleKey>.result.mic via the S-tags.
	// File-set regex collects whatever mitool actually writes — barcodes with
	// zero hits produce no file, so pre-declared per-tuple saveFile would
	// reference non-existent files.
	parse := exec.builder().
		printErrStreamToStdout().
		env("MI_PROGRESS_PREFIX", progressPrefix).
		software(mitoolSw).
		cpu(8).
		mem("16GiB").
		arg("parse").
		arg("--pattern").arg(expandedPattern).
		arg("--threads").argWithVar("{system.cpu}").
		addFile("input_R1.fastq.gz", R1File)

	if !is_undefined(limitInput) {
		parse = parse.arg("--limit").arg(string(limitInput))
	}

	if isPaired {
		parse = parse.addFile("input_R2.fastq.gz", R2File)
		parse = parse.arg("input_{{R}}.fastq.gz")
	} else {
		parse = parse.arg("input_R1.fastq.gz")
	}

	parse = parse.
		arg("--report").arg("report.txt").saveFile("report.txt").
		arg("--json-report").arg("report.json").
		saveFile("report.json").saveFileContent("report.json").
		arg("--no-stdout-report").
		// Filename layout `<v_S1>_<v_S2>...result.mic` — multi-tag uses `_` as
		// the value separator, so the regex must include `_`.
		saveFileSet("mics", "^[A-Za-z0-9_]+\\.result\\.mic$").
		saveStdoutStream().
		arg("result.mic").
		run()

	reportsBuilder := pcolumn.resourceMapBuilder(1)
	reportsBuilder.add(["txt"], parse.getFile("report.txt"))
	reportsBuilder.add(["json"], parse.getFile("report.json"))

	return {
		mics: parse.getFileSet("mics"),
		tupleToSample: tupleToSample,
		isPaired: isPaired,
		mitoolLog: parse.getStdoutStream(),
		reports: reportsBuilder.build(),
		reportJsonContent: parse.getFileContent("report.json")
	}
})
