// Per-group export stage.
//
// Invoked by demux-group.tpl.tengo once parse has produced a file-set of
// <barcode>.result.mic files. This template awaits the file-set being ready,
// enumerates the files that actually exist (mitool's MultiSampleRun creates
// per-sample writers lazily, so barcodes with zero matches produce no file),
// then runs `mitool export-fastq` for each present barcode, assembling a
// ResourceMap keyed by [sampleId, readIndex].
//
// Per-sample matched-read counts are NOT emitted here: mitool's default
// splitBySample=true strips sample-level tags (SMPL1) from the per-sample
// .mic headers (TagParsePipeline.kt:309-311), so `mitool tag-stat --tags SMPL1`
// fails with "Tag SMPL1 not found". See .meta/mitool-parse-json-report.md —
// once mitool exposes a record-count CLI (or tag-stat grows a `no-tags`
// mode), we'll add matchedCounts back and wire the qc PColumn.
//
// Inputs:
//   mics:            file-set resource { "<barcode>.result.mic" -> File }
//   barcodeToSample: JSON { "<barcode>": "<sampleId>", ... } for this group
//   isPaired:        JSON bool — whether we should also export R2

self := import("@platforma-sdk/workflow-tengo:tpl")
exec := import("@platforma-sdk/workflow-tengo:exec")
assets := import("@platforma-sdk/workflow-tengo:assets")
pcolumn := import("@platforma-sdk/workflow-tengo:pframes.pcolumn")
text := import("text")

self.defineOutputs("demultiplexedFastq")

self.awaitState("mics", "ResourceReady")
self.awaitState("barcodeToSample", "ResourceReady")
self.awaitState("isPaired", "ResourceReady")

mitoolSw := assets.importSoftware("@platforma-open/milaboratories.software-mitool:main")

MIC_SUFFIX := ".result.mic"

self.body(func(inputs) {
	// tpl/base.lib.tengo:_unmarshal recursively decodes inputs for ephemeral
	// templates: JSON resources → plain values, map resources → Tengo maps
	// of field -> unmarshalled value, everything else → raw resource. So:
	//   inputs.mics            → Tengo map { "<barcode>.result.mic": fileRes }
	//   inputs.barcodeToSample → Tengo map { "<barcode>": "<sampleId>" }
	//   inputs.isPaired        → bool
	// Do NOT call .inputs() / .getDataAsJson() here — they're already decoded.
	mics := inputs.mics
	barcodeToSample := inputs.barcodeToSample
	isPaired := inputs.isPaired

	progressPrefix := "[==MITOOL_PROGRESS==]"
	fastqBuilder := pcolumn.resourceMapBuilder(2)

	suffixLen := len(MIC_SUFFIX)
	for fileName, micFile in mics {
		if !text.has_suffix(fileName, MIC_SUFFIX) {
			continue
		}
		bc := text.substr(fileName, 0, len(fileName) - suffixLen)
		sampleId := barcodeToSample[bc]
		if is_undefined(sampleId) {
			// Mitool captured a barcode outside our expected set — possible when
			// the pattern uses a wildcard SMPL1 capture. Safe to drop.
			continue
		}

		exportCmd := exec.builder().
			printErrStreamToStdout().
			env("MI_PROGRESS_PREFIX", progressPrefix).
			software(mitoolSw).
			cpu(4).
			mem("16GiB").
			arg("export-fastq").
			arg("--output-file").arg("R1.fastq.gz").arg("R1").saveFile("R1.fastq.gz").
			addFile(fileName, micFile)

		if isPaired {
			exportCmd = exportCmd.arg("--output-file").arg("R2.fastq.gz").arg("R2").saveFile("R2.fastq.gz")
		}

		exportResult := exportCmd.arg(fileName).run()

		fastqBuilder.add([sampleId, "R1"], exportResult.getFile("R1.fastq.gz"))
		if isPaired {
			fastqBuilder.add([sampleId, "R2"], exportResult.getFile("R2.fastq.gz"))
		}
	}

	return {
		demultiplexedFastq: fastqBuilder.build()
	}
})
