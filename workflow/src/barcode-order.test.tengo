test := import("@platforma-sdk/workflow-tengo:test")
text := import("text")
barcodeOrder := import(":barcode-order")

_row := func(sampleId, values) {
	return { sampleId: sampleId, values: values, tupleKey: text.join(values, "_") }
}

// No tag is followed by a fixed run in the pattern.
_open := [[], []]

// Overlaps of `rows` taken in alternative order.
_overlaps := func(rows, runs) {
	return barcodeOrder.prefixOverlaps("g1", barcodeOrder.orderRows(rows), runs)
}

_sampleIds := func(rows) {
	out := []
	for r in rows {
		out = append(out, r.sampleId)
	}
	return out
}

Test_orderRows_putsLongerBarcodeBeforeItsPrefix := func() {
	rows := [_row("short", ["ACGTACG"]), _row("long", ["ACGTACGTTG"])]
	test.isEqual(["long", "short"], _sampleIds(barcodeOrder.orderRows(rows)),
		"10-nt barcode precedes the 7-nt barcode it extends")
}

Test_orderRows_isIndependentOfInputOrder := func() {
	a := [_row("s7", ["AACTGAC"]), _row("s10", ["AAGGTCTCGT"]), _row("s8", ["ACGGAGTG"]), _row("s7b", ["ACCTTCG"])]
	b := [a[3], a[1], a[0], a[2]]
	test.isEqual(_sampleIds(barcodeOrder.orderRows(a)), _sampleIds(barcodeOrder.orderRows(b)),
		"same rows in any order give the same sequence")
	test.isEqual(["s10", "s8", "s7", "s7b"], _sampleIds(barcodeOrder.orderRows(a)),
		"length descending, then tupleKey ascending")
}

Test_orderRows_usesTotalLengthAcrossTags := func() {
	rows := [_row("short", ["ACGT", "GGCC"]), _row("long", ["ACGT", "GGCCAA"])]
	test.isEqual(["long", "short"], _sampleIds(barcodeOrder.orderRows(rows)),
		"two-tag row that extends the other on one tag comes first")
}

Test_prefixOverlaps_reportsExactPrefix := func() {
	rows := [_row("short", ["ACGTACG"]), _row("long", ["ACGTACGTTG"]), _row("other", ["TTTTTTT"])]
	test.isEqual([{
		sampleGroupId: "g1",
		from: { sampleId: "short", barcodes: ["ACGTACG"] },
		to: { sampleId: "long", barcodes: ["ACGTACGTTG"] }
	}], _overlaps(rows, [[]]), "short's reads can go to long, listed first")
}

Test_prefixOverlaps_needsEveryTagToBePrefixed := func() {
	rows := [_row("a", ["ACGT", "GGCC"]), _row("b", ["ACGTAA", "TTCC"])]
	test.isEqual([], _overlaps(rows, _open), "second tag differs, no overlap")
}

Test_prefixOverlaps_ignoresSameSampleAlternatives := func() {
	rows := [_row("s1", ["ACGT"]), _row("s1", ["ACGTAA"])]
	test.isEqual([], _overlaps(rows, [[]]), "both rows route to the same sample")
}

Test_prefixOverlaps_emptyForEqualLengthBarcodes := func() {
	rows := [_row("a", ["ACGTACGT"]), _row("b", ["ACGTACGA"]), _row("c", ["TTGCAACC"])]
	test.isEqual([], _overlaps(rows, [[]]), "fixed-length set never overlaps")
}

Test_prefixOverlaps_treatsNInBarcodeAsAnyBase := func() {
	test.isEqual(1, len(_overlaps([_row("a", ["ACGN"]), _row("b", ["ACGTAA"])], [[]])),
		"ACGN matches the start of ACGTAA")
	test.isEqual(1, len(_overlaps([_row("a", ["ACGN"]), _row("b", ["ACGT"])], [[]])),
		"equal-length barcodes that differ only at an N match the same read")
	test.isEqual(0, len(_overlaps([_row("a", ["ACNA"]), _row("b", ["ACGTAA"])], [[]])),
		"a known base after the N still separates")
}

Test_prefixOverlaps_fixedRunSeparatesOnlyWhereItDiffers := func() {
	rows := [_row("short", ["ACGTACG"]), _row("long", ["ACGTACGTTG"])]
	test.isEqual(0, len(_overlaps(rows, [["G"]])),
		"a fixed G after the barcode, where the longer barcode has T, keeps the samples apart")
	test.isEqual(1, len(_overlaps(rows, [["T"]])),
		"a fixed T after the barcode is what the longer barcode has there too")
	test.isEqual(0, len(_overlaps(rows, [["T", "G"]])),
		"the occurrence followed by G separates them, even if another is followed by T")
}

Test_prefixOverlaps_onePinnedDifferingTagSeparates := func() {
	rows := [_row("short", ["ACGT", "GGCC"]), _row("long", ["ACGTAA", "GGCCTT"])]
	test.isEqual([], _overlaps(rows, [["G"], []]),
		"the longer row's alternative must match every tag, so one separating tag is enough")
	test.isEqual(1, len(_overlaps(rows, [["A"], []])),
		"a run equal to the longer barcode's next base does not separate")
}

Test_prefixOverlaps_ignoresPinOnEqualLengthTag := func() {
	rows := [_row("short", ["ACGT", "GGCC"]), _row("long", ["ACGT", "GGCCTT"])]
	test.isEqual(1, len(_overlaps(rows, [["G"], []])),
		"pinning a tag that is equal in both rows does not separate them")
}

// A is longer on tag 1, B on tag 2. A B read whose R1 insert starts with AA matches
// both alternatives exactly; mitool 2.3.1-174-main sends it to A, the first one.
Test_prefixOverlaps_reportsCrossedMultiTagOverlap := func() {
	rows := [_row("A", ["ACGTAA", "GGCC"]), _row("B", ["ACGT", "GGCCTT"])]
	runs := barcodeOrder.fixedRuns("^{S1}(R1:*)\\^{S2}(R2:*)", ["S1", "S2"])
	test.isEqual([{
		sampleGroupId: "g1",
		from: { sampleId: "B", barcodes: ["ACGT", "GGCCTT"] },
		to: { sampleId: "A", barcodes: ["ACGTAA", "GGCC"] }
	}], _overlaps(rows, runs), "each row extends the other on one tag, so a read can match both")
}

// The long alternative needs ACGTGA then GG; a short read has ACGT then GG, so
// position 6 is G where the long barcode has A. mitool routes every read correctly.
Test_prefixOverlaps_skipsPairSeparatedByLaterPinnedBase := func() {
	rows := [_row("short", ["ACGT"]), _row("long", ["ACGTGA"])]
	runs := barcodeOrder.fixedRuns("^{S1}GG(R1:*)\\^(R2:*)", ["S1"])
	test.isEqual([], _overlaps(rows, runs),
		"the second fixed G differs from the long barcode's A")
}

// After ACGT come two free bases and TT; the long barcode has AA there, so neither
// alternative matches the other sample's reads.
Test_prefixOverlaps_skipsPairSeparatedByFixedBasesAfterN := func() {
	rows := [_row("short", ["ACGT"]), _row("long", ["ACGTGGAA"])]
	runs := barcodeOrder.fixedRuns("^{S1}N{2}TT(R1:*)\\^(R2:*)", ["S1"])
	test.isEqual([], _overlaps(rows, runs),
		"TT after N{2} differs from the long barcode's AA")
}

Test_fixedRuns_stopsAtVariableContent := func() {
	test.isEqual([["GGGAAA"], ["NN"], []],
		barcodeOrder.fixedRuns("^{S1}GGGAAA{S2}N{2}(R1:*)\\^{S3}(R2:*)", ["S1", "S2", "S3"]),
		"S1 runs to the next placeholder; S2 to the capture; S3 has none")
	test.isEqual([["NA"]], barcodeOrder.fixedRuns("^{S1}N{1}AN{2:3}C(R1:*)", ["S1"]),
		"N{2:3} has no fixed length; the run ends before it")
	test.isEqual([["GTT"]], barcodeOrder.fixedRuns("^{S1}GT{2}A{0:2}C(R1:*)", ["S1"]),
		"T{2} is two fixed bases; A{0:2} may be absent, so the run ends before it")
}

Test_fixedRuns_collectsEveryOccurrence := func() {
	test.isEqual([["A", "TTT"]], barcodeOrder.fixedRuns("^{S1}A(R1:*)\\^{S1}TTT(R2:*)", ["S1"]),
		"runs after the placeholder on R1 and on R2")
}

Test_fixedRuns_doesNotConfuseS1WithS10 := func() {
	names := ["S1", "S2", "S3", "S4", "S5", "S6", "S7", "S8", "S9", "S10"]
	runs := barcodeOrder.fixedRuns("^{S1}{S10}A(R1:*)", names)
	test.isEqual([], runs[0], "{S10}A does not pin S1")
	test.isEqual(["A"], runs[9], "{S10}A pins S10")
}
